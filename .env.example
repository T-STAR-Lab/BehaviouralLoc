# Fill in the providers you intend to use. python-dotenv auto-loads this file.
# Only the providers you actually call need to be set.

# DashScope (Aliyun, OpenAI-compatible)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# OpenAI (gpt-5.2, gpt-4.1)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (claude-sonnet-*)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Google (gemini-3-pro-*)
GOOGLE_API_KEY=
GOOGLE_BASE_URL=

# Local vLLM server (used when --models has `vllm:<served-name>` prefix)
VLLM_BASE_URL=
